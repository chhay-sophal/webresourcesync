{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Web Resource Sync",
  "version": "0.1.0",
  "identifier": "com.sophaldev.webresourcesync",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace web",
    "beforeBuildCommand": "npm run build --workspace web"
  },
  "app": {
    "windows": [
      {
        "title": "Web Resource Sync",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/chhay-sophal/webresourcesync/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NzQ2OUZBN0U5NjAyMjUKUldRbEFwWisrbWwwbHlpWkVqZDZ0N3l1emFWbnRqTlFYaUhnV3liYThUWmxYVEhQVDJ5ZWYzTVIK"
    }
  }
}
