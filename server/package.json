{
  "name": "webresourcesync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist-bundle/server.cjs --external:fsevents --external:bufferutil --external:utf-8-validate",
    "package": "pkg dist-bundle/server.cjs --targets node22-win-x64 --output dist-bundle/server-win.exe",
    "prepare-sidecar": "npm run bundle && npm run package && node ../scripts/copy-sidecar.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "chokidar": "^4.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "open": "^11.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
