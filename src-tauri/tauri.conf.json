{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "webresourcesync",
  "version": "0.1.0",
  "identifier": "com.sophaldev.webresourcesync",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace web",
    "beforeBuildCommand": "npm run build --workspace web"
  },
  "app": {
    "windows": [
      {
        "title": "Web Resource Sync",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["binaries/server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
